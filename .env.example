# Optional development settings. Copy to .env (gitignored); the Makefile exports every key to its recipes.
# Port of `make serve` (scripts/server.mjs).
PORT=8080
# Port of the server Playwright starts for the browser e2e suite.
E2E_PORT=4319
# Runtimes the e2e suite runs the packed package and every example on; default: node and bun from PATH.
NODE_BINARY=node
BUN_BINARY=bun
# Set by scripts/e2e.mjs for the suites it starts; leave empty. They name the clean consumer project, the packed
# tarball and the installed build that the website is served with.
DSON_CONSUMER=
DSON_TARBALL=
DSON_LIB=
